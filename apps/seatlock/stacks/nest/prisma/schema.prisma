// Prisma models over the shared schema in ../../db/migrations. The SQL files own the tables;
// this file only maps them (`prisma db pull` can regenerate it). Chapter 15.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  venue     String
  startsAt  DateTime @map("starts_at") @db.Timestamptz(6)
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  seats     Seat[]
  holds     Hold[]

  @@map("events")
}

model Hold {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id])
  userId    String   @map("user_id")
  seatIds   String[] @map("seat_ids") @db.Uuid
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  seats     Seat[]
  order     Order?

  @@map("holds")
}

model Seat {
  id         String      @id @default(uuid()) @db.Uuid
  eventId    String      @map("event_id") @db.Uuid
  event      Event       @relation(fields: [eventId], references: [id])
  section    String
  rowLabel   String      @map("row_label")
  number     Int
  priceCents Int         @map("price_cents")
  status     String      @default("available")
  holdId     String?     @map("hold_id") @db.Uuid
  hold       Hold?       @relation(fields: [holdId], references: [id])
  lines      OrderLine[]

  @@unique([eventId, section, rowLabel, number])
  @@map("seats")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  holdId          String      @unique @map("hold_id") @db.Uuid
  hold            Hold        @relation(fields: [holdId], references: [id])
  userId          String      @map("user_id")
  totalCents      Int         @map("total_cents")
  currency        String      @default("USD")
  status          String      @default("pending")
  paymentIntentId String?     @unique @map("payment_intent_id")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  lines           OrderLine[]

  @@map("orders")
}

model OrderLine {
  orderId    String @map("order_id") @db.Uuid
  seatId     String @map("seat_id") @db.Uuid
  priceCents Int    @map("price_cents")
  order      Order  @relation(fields: [orderId], references: [id])
  seat       Seat   @relation(fields: [seatId], references: [id])

  @@id([orderId, seatId])
  @@map("order_lines")
}

model IdempotencyKey {
  key         String
  userId      String   @map("user_id")
  requestHash String   @map("request_hash")
  status      Int?
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([userId, key])
  @@map("idempotency_keys")
}

model WebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@map("webhook_events")
}
