---
// The same concept in every stack. Web: synced tabs (pick Go once, every block shows Go).
// Print: every panel shown, stacked, each with its own label.
import { Tabs } from '@astrojs/starlight/components';
// sync={false} for blocks that compare styles inside one stack (Express vs Nest), so they
// do not change the reader's chosen language.
// printOnly: the print edition shows only that stack's panel (the problem bank prints one language).
import type { StackId } from './stacks';
interface Props { title?: string; note?: string; sync?: boolean; printOnly?: StackId }
const { title = 'Five Stacks', note, sync = true, printOnly } = Astro.props;
---
<section class="bp-stacks" data-print-only={printOnly}>
  <div class="bp-stacks__head">
    <span class="bp-label">{title}</span>
    {note && <span class="bp-stacks__note">{note}</span>}
  </div>
  <Tabs syncKey={sync ? 'stack' : undefined}><slot /></Tabs>
</section>
