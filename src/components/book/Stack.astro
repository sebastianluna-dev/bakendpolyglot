---
import { TabItem } from '@astrojs/starlight/components';
import { STACKS, type StackId } from './stacks';
interface Props { id: StackId; lib?: string; label?: string }
const { id, lib, label } = Astro.props;
const s = STACKS[id];
const name = label ?? s.name;
---
<TabItem label={name}>
  <div class="bp-stack__label"><span class="bp-dot" style={`background:${s.color}`}></span><b>{name}</b>{lib && <i> · {lib}</i>}</div>
  <slot />
</TabItem>
